{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "import",
    "typescript",
    "promise",
    "react",
    "unicorn",
    "nextjs",
    "vitest"
  ],
  "categories": {
    "correctness": "off"
  },
  "env": {
    "builtin": true,
    "es2026": true,
    "browser": true,
    "node": true
  },
  "settings": {
    "react": {
      "version": "19.2.4"
    },
    "import/resolver": {
      "typescript": {
        "alwaysTryTypes": true,
        "project": "tsconfig.json"
      }
    }
  },
  "ignorePatterns": [
    ".next/*",
    "next-env.d.ts",
    "src/__tests__/utils/*",
    "coverage/*",
    "src/components/ui/*"
  ],
  "rules": {
