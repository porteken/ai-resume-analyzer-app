    "eslint-plugin-playwright": "^2.11.0",
    "globals": "^17.9.0",
    "happy-dom": "^20.11.2",
    "knip": "^6.32.0",
    "lint-staged": "^17.3.0",
    "msw": "^2.15.0",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "oxlint-tsgolint": "^7.0.2001",
    "playwright": "^1.62.1",
    "postcss": "^8.5.26",
