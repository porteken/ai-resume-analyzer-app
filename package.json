    "happy-dom": "^21.0.3",
    "knip": "^6.41.0",
    "lint-staged": "^17.6.0",
    "msw": "^3.0.3",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
